# ── LLM Provider ───────────────────────────────────────────────────────
# Provider and model. Providers are resolved by the SDK; only bundled
# providers (see BUNDLED_LLM_PROVIDERS in server/main.py) are allowed
# when reconfiguring via /configure at runtime.
#   Bundled: openai | anthropic | gemini | minimax | deepseek | lmstudio
MEM0_DEFAULT_LLM_PROVIDER=openai
MEM0_DEFAULT_LLM_MODEL=gpt-4.1-nano-2025-04-14

# Provider-specific env vars. Set only the ones your chosen provider needs.
# Each provider class reads its own vars from the environment directly.

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=                 # optional, defaults to https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=

# Gemini
# GOOGLE_API_KEY=

# MiniMax
# MINIMAX_API_KEY=
# MINIMAX_API_BASE=                # optional, defaults to https://api.minimax.io/v1

# DeepSeek
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=               # optional, defaults to https://api.deepseek.com

# LM Studio (local LLM — no API key needed)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Extra LLM parameters passed to the provider config as a JSON object.
# Only keys accepted by the configured provider's config class take effect;
# unknown keys are silently dropped. Useful for provider-specific settings.
# MEM0_LLM_EXTRA_PARAMS={"enable_thinking": false}
# MEM0_LLM_EXTRA_PARAMS={"reasoning_effort": "high"}

# ── Embedder Provider ───────────────────────────────────────────────────
#   Bundled: openai | gemini | lmstudio
MEM0_DEFAULT_EMBEDDER_PROVIDER=openai
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small
# Embedding dimensions — must match the model's output. Common values:
#   OpenAI text-embedding-3-small: 1024 (default)
#   LM Studio bge-m3: 1024
#   OpenAI text-embedding-3-large: 3072
#   OpenAI text-embedding-ada-002: 1536
MEM0_DEFAULT_EMBEDDING_DIMS=1024

# LM Studio (local embedding — no API key needed)
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Extra embedder parameters passed to the embedder config as a JSON object.
# MEM0_EMBEDDER_EXTRA_PARAMS={}

# ── Vector Store ────────────────────────────────────────────────────────
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=

# ── Authentication ──────────────────────────────────────────────────────
ADMIN_API_KEY=
JWT_SECRET=
# Local development only. Leave false in production.
AUTH_DISABLED=false
DASHBOARD_URL=http://localhost:3000
DASHBOARD_API_URL=http://localhost:8888
DASHBOARD_NODE_ENV=production
# Set to "true" when the dashboard is served over HTTPS.
# When accessed over plain HTTP (self-hosted, Tailscale, etc.), keep this
# as false — otherwise browsers will refuse to store the auth cookie.
DASHBOARD_COOKIE_SECURE=false
APP_DB_NAME=mem0_app

# ── Telemetry & Logging ─────────────────────────────────────────────────
# Anonymous telemetry. Sends a single onboarding event per install
# (install UUID, email domain, server version, source). No PII.
# Set to false to opt out.
MEM0_TELEMETRY=true

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30
